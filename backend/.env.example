APP_NAME=Branch Opening Platform
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/branch_opening
SECRET_KEY=change-me-in-production
TOKEN_EXPIRE_MINUTES=480
UPLOAD_DIR=./uploads
# API hardening (rate limiting, request size limits)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TRUSTED_HOSTS=127.0.0.1,::1,localhost,testclient
MAX_REQUEST_BODY_BYTES=1048576
